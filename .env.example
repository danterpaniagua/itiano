SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

JIRA_WEBHOOK_SECRET=

# Used by `python manage.py jira_reconcile` to backfill status history
# missed during app downtime. Basic Auth against Jira Cloud REST API v3.
JIRA_API_BASE_URL=
JIRA_API_EMAIL=
JIRA_API_TOKEN=

# MongoDB. Default: the local `mongo` service of docker-compose (single-node replica set, data in the
# `mongo_data` volume). For Atlas use a mongodb+srv:// URI; credentials may be inline in the URI, otherwise
# set MONGODB_USERNAME / MONGODB_PASSWORD.
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=itiano
# Optional: keep an Atlas connection here (only used by hand, e.g. mongodump / mongorestore).
# MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
